#!/bin/sh
set -eu
root=/opt/proanima-arkvory
setup='/usr/lib/proanima-arkvory/arkvory-setup.mjs'
case "${1:-help}" in
  help|--help|-h) exec /usr/lib/proanima-arkvory/node "$setup" help ;;
  # HA cluster commands (ADR 0072) that act on Pacemaker run from the package files: the plan
  # exists before the replicated volume, and a switchover unmounts the volume this command
  # would otherwise run from.
  cluster-plan|cluster-check|cluster-switchover|cluster-fence-test)
    exec /usr/lib/proanima-arkvory/node "$setup" "$@" ;;
esac
exec "$root/runtime/node" "$root/manage.mjs" "$@"
