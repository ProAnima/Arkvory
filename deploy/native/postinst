#!/bin/sh
set -eu
root=/opt/proanima-arkvory
payload=/usr/lib/proanima-arkvory
mkdir -p "$root/runtime"
if [ ! -f "$root/installation.json" ]; then chmod 0700 "$root"; fi
if [ ! -f "$root/runtime/node" ]; then install -m 0755 "$payload/node" "$root/runtime/node"; fi
if [ -f "$root/installation.json" ]; then
  "$root/runtime/node" "$payload/arkvory-setup.mjs" apply-installer --root "$root" --artifact "$payload"
else
  pg_bin=$(python3 - <<'PY'
import glob, os, subprocess
paths = glob.glob('/usr/lib/postgresql/*/bin') + glob.glob('/usr/pgsql-*/bin') + ['/usr/bin', '/usr/lib/pgsql/bin']
candidates = []
for path in paths:
    executable = os.path.join(path, 'postgres')
    if os.path.isfile(executable):
        version = subprocess.check_output([executable, '--version'], text=True).split()[-1].split('.')[0]
        if version.isdigit() and 16 <= int(version) <= 19 and os.path.isfile(os.path.join(path, 'initdb')):
            candidates.append((int(version), path))
if not candidates:
    raise SystemExit('PostgreSQL 16–19 server binaries are required')
print(max(candidates)[1])
PY
)
  "$root/runtime/node" "$payload/arkvory-setup.mjs" install --root "$root" --mode systemd --artifact "$payload" --database-bin "$pg_bin"
fi
echo 'Arkvory: http://127.0.0.1:8080/console/#onboarding'
echo 'Recovery credential (administrator only): /opt/proanima-arkvory/config/bootstrap-token.txt'
