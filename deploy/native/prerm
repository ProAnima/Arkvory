#!/bin/sh
set -eu
# Package upgrades preserve running services until the journalled updater switches code.
case "${1:-}" in upgrade|1) exit 0 ;; esac
for unit in arkvory-backup arkvory-worker arkvory-api arkvory-database arkvory-update.timer; do
  if systemctl cat "$unit" >/dev/null 2>&1; then
    systemctl disable --now "$unit"
  fi
done
# No rm -rf: /opt/proanima-arkvory is intentionally retained with all blobs and credentials.
# The backup vault (outside the root) and its unit drop-in are left as they are.
