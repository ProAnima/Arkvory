# Generate real local secrets with npm run init:local.
DEPOT_DATABASE_URL=postgresql://depot:replace-with-generated-password@127.0.0.1:55432/depot
DEPOT_POSTGRES_PASSWORD=replace-with-generated-password
DEPOT_DATA_DIR=./data/storage
DEPOT_KEYS_FILE=./data/service-keys.json
DEPOT_TOKEN_FILE=./data/local-token.txt
DEPOT_BASE_URL=http://127.0.0.1:8080
DEPOT_HOST=127.0.0.1
DEPOT_PORT=8080
DEPOT_CAPACITY_BYTES=10995116277760
DEPOT_MAX_UPLOADS=2
DEPOT_MAX_DOWNLOADS=16
DEPOT_MAX_UPLOADS_PER_PRINCIPAL=1
DEPOT_MAX_DOWNLOADS_PER_PRINCIPAL=4
# Payload bytes/s; 0 disables that rate ceiling. Per-principal limits cover all its keys/streams.
DEPOT_UPLOAD_BYTES_PER_SECOND=0
DEPOT_DOWNLOAD_BYTES_PER_SECOND=0
DEPOT_UPLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0
DEPOT_DOWNLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0
