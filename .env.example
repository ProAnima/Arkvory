# Generate real local secrets with npm run init:local.
ARKVORY_DATABASE_URL=postgresql://arkvory:replace-with-generated-password@127.0.0.1:55432/arkvory
ARKVORY_POSTGRES_PASSWORD=replace-with-generated-password
ARKVORY_DATA_DIR=./data/storage
ARKVORY_KEYS_FILE=./data/service-keys.json
ARKVORY_TOKEN_FILE=./data/local-token.txt
ARKVORY_BASE_URL=http://127.0.0.1:8080
ARKVORY_HOST=127.0.0.1
ARKVORY_PORT=8080
# Optional exact browser origins for a UI hosted on another server; HTTPS except loopback.
# ARKVORY_CORS_ORIGINS=https://ui.example.com
ARKVORY_CAPACITY_BYTES=10995116277760
ARKVORY_MAX_UPLOADS=2
ARKVORY_MAX_DOWNLOADS=16
ARKVORY_MAX_UPLOADS_PER_PRINCIPAL=1
ARKVORY_MAX_DOWNLOADS_PER_PRINCIPAL=4
ARKVORY_TRANSFER_QUEUE_LIMIT=64
ARKVORY_TRANSFER_QUEUE_PER_PRINCIPAL=8
ARKVORY_TRANSFER_QUEUE_TIMEOUT_MS=20000
# Sender idle time excludes storage/shaping; absolute budget covers each admitted PUT/complete.
ARKVORY_UPLOAD_IDLE_TIMEOUT_MS=30000
ARKVORY_UPLOAD_DEADLINE_MS=1800000
# Payload bytes/s; 0 disables that rate ceiling. Per-principal limits cover all its keys/streams.
ARKVORY_UPLOAD_BYTES_PER_SECOND=0
ARKVORY_DOWNLOAD_BYTES_PER_SECOND=0
ARKVORY_UPLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0
ARKVORY_DOWNLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0

# Optional shared-storage read gateways; configure every field consistently before enabling.
# See docs/READ_GATEWAYS.md. Writer uses slot 0, reader uses slot 1.
# ARKVORY_ROLE=api
# ARKVORY_GATEWAY_SLOTS=2
# ARKVORY_GATEWAY_SLOT=0
# ARKVORY_SHARED_DOWNLOAD_BYTES_PER_SECOND=67108864
# ARKVORY_SHARED_DOWNLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=16777216

# Optional ceiling for one object in bytes; unset uses the multipart layout limit (about 10 TiB).
# ARKVORY_MAX_OBJECT_BYTES=1099511627776
# Self-service account registration for the console; disabled unless set to true.
# ARKVORY_ALLOW_REGISTRATION=false
