# Generate real local secrets with npm run init:local.
ARKVORY_DATABASE_URL=postgresql://arkvory:replace-with-generated-password@127.0.0.1:55432/arkvory
ARKVORY_POSTGRES_PASSWORD=replace-with-generated-password
ARKVORY_DATA_DIR=./data/storage
ARKVORY_KEYS_FILE=./data/service-keys.json
ARKVORY_TOKEN_FILE=./data/local-token.txt
ARKVORY_BASE_URL=http://127.0.0.1:8080
ARKVORY_HOST=127.0.0.1
ARKVORY_PORT=8080
# Built-in HTTPS for remote clients (both files together). Renewed files are reloaded.
# ARKVORY_TLS_CERT_FILE=/etc/arkvory/tls/fullchain.pem
# ARKVORY_TLS_KEY_FILE=/etc/arkvory/tls/privkey.pem
# ARKVORY_TLS_MIN_VERSION=TLSv1.2
# ARKVORY_TLS_RELOAD_SECONDS=300
# Optional exact browser origins for a UI hosted on another server; HTTPS except loopback.
# ARKVORY_CORS_ORIGINS=https://ui.example.com
ARKVORY_CAPACITY_BYTES=10995116277760
ARKVORY_MAX_UPLOADS=2
ARKVORY_MAX_DOWNLOADS=16
ARKVORY_MAX_UPLOADS_PER_PRINCIPAL=1
ARKVORY_MAX_DOWNLOADS_PER_PRINCIPAL=4
# Download queue for objects over 16 MiB (ADR 0076); every value below is the default.
# Strategy: ordered | smallest-first | shared (no queue; the default of every process when read
# gateways are configured, the writer included).
ARKVORY_DOWNLOAD_STRATEGY=ordered
# ARKVORY_MAX_DOWNLOAD_SESSIONS=16
# ARKVORY_DOWNLOAD_RESERVE=1
# ARKVORY_DOWNLOAD_WEIGHTS=interactive=8,release=4,bulk=2,background=1
# ARKVORY_DOWNLOAD_SESSION_MIN_BYTES=16777216
# ARKVORY_DOWNLOAD_IDLE_SECONDS=30
# ARKVORY_DOWNLOAD_AGING_MINUTES=15
# ARKVORY_DOWNLOAD_PREEMPT=true
# ARKVORY_DOWNLOAD_RANGES_PER_SESSION=4
# ARKVORY_DOWNLOAD_QUEUE_LIMIT=65536
# ARKVORY_DOWNLOAD_QUEUE_PER_PRINCIPAL=4096
# ARKVORY_DOWNLOAD_HOLD_SECONDS=20
ARKVORY_TRANSFER_QUEUE_LIMIT=64
ARKVORY_TRANSFER_QUEUE_PER_PRINCIPAL=8
ARKVORY_TRANSFER_QUEUE_TIMEOUT_MS=20000
# Sender idle time excludes storage/shaping; absolute budget covers each admitted PUT/complete.
ARKVORY_UPLOAD_IDLE_TIMEOUT_MS=30000
ARKVORY_UPLOAD_DEADLINE_MS=1800000
# Payload bytes/s; 0 disables that rate ceiling. Per-principal limits cover all its keys/streams.
ARKVORY_UPLOAD_BYTES_PER_SECOND=0
ARKVORY_DOWNLOAD_BYTES_PER_SECOND=0
ARKVORY_UPLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0
ARKVORY_DOWNLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=0
# Concurrent authenticated requests; must exceed MAX_UPLOADS + MAX_DOWNLOADS. Health is exempt.
ARKVORY_MAX_REQUESTS=128
# API query pool (4-200); up to three connections stay held by ownership/lease sessions.
ARKVORY_DATABASE_POOL_SIZE=10
# Free bytes kept on the storage volume (default 1 GiB); 0 disables the reserve.
ARKVORY_STORAGE_RESERVE_BYTES=1073741824
# Free inodes kept on each volume (default 100000); file systems without an inode count skip it.
ARKVORY_STORAGE_RESERVE_INODES=100000
# Copy speed of moves between volumes (arkvory storage rehome), bytes/s; 0 = no limit.
ARKVORY_REHOME_BYTES_PER_SECOND=0
# One JSON line per request on stdout: route template, status, duration, bytes, principal, ip.
ARKVORY_ACCESS_LOG=true
# SIGTERM/SIGINT lets admitted transfers finish for this long before closing connections.
ARKVORY_DRAIN_TIMEOUT_MS=30000
# Minimum JSON log level for API and worker: debug, info, warning or error (warning hides access log).
ARKVORY_LOG_LEVEL=info

# Optional shared-storage read gateways; configure every field consistently before enabling.
# See docs/READ_GATEWAYS.md. Writer uses slot 0, reader uses slot 1.
# ARKVORY_ROLE=api
# ARKVORY_GATEWAY_SLOTS=2
# ARKVORY_GATEWAY_SLOT=0
# ARKVORY_SHARED_DOWNLOAD_BYTES_PER_SECOND=67108864
# ARKVORY_SHARED_DOWNLOAD_BYTES_PER_SECOND_PER_PRINCIPAL=16777216

# Optional ceiling for one object in bytes; unset uses the multipart layout limit (about 10 TiB).
# ARKVORY_MAX_OBJECT_BYTES=1099511627776
# Self-service account registration for the console; disabled unless set to true.
# Throttled per client address and stopped at 900 accounts (the last 100 stay for administrators).
# ARKVORY_ALLOW_REGISTRATION=false
# Reverse proxies whose X-Forwarded-For is trusted for client addresses (IP or CIDR, comma-separated).
# Without it, login throttling sees every client behind the proxy as one address. Their X-Request-Id
# is kept for correlation, so a trusted proxy must overwrite that header for every request.
# ARKVORY_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
