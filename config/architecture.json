{
  "limits": {
    "file": 500,
    "class": 300,
    "function": 100
  },
  "maxExceptionDays": 90,
  "units": [
    {
      "path": "packages/domain",
      "allowed": []
    },
    {
      "path": "packages/contracts",
      "allowed": []
    },
    {
      "path": "packages/extension-api",
      "allowed": []
    },
    {
      "path": "packages/resolution",
      "allowed": []
    },
    {
      "path": "packages/signing",
      "allowed": ["packages/extension-api"]
    },
    {
      "path": "packages/application",
      "allowed": ["packages/domain"]
    },
    {
      "path": "packages/infrastructure",
      "allowed": [
        "packages/application",
        "packages/domain",
        "packages/extension-api",
        "packages/signing"
      ]
    },
    {
      "path": "packages/sdk",
      "allowed": ["packages/contracts", "packages/extension-api"]
    },
    {
      "path": "apps/cli",
      "allowed": [
        "packages/sdk",
        "packages/contracts",
        "packages/resolution",
        "packages/extension-api",
        "packages/signing"
      ]
    },
    {
      "path": "apps/api",
      "allowed": [
        "packages/application",
        "packages/domain",
        "packages/contracts",
        "packages/infrastructure",
        "packages/extension-api",
        "packages/resolution"
      ]
    },
    {
      "path": "apps/worker",
      "allowed": [
        "packages/application",
        "packages/domain",
        "packages/infrastructure",
        "packages/sdk",
        "packages/resolution"
      ]
    },
    {
      "path": "apps/scheduler",
      "allowed": ["packages/application", "packages/domain", "packages/infrastructure"]
    },
    {
      "path": "apps/backup",
      "allowed": [
        "packages/application",
        "packages/domain",
        "packages/infrastructure",
        "packages/resolution"
      ]
    },
    {
      "path": "apps/web",
      "allowed": ["packages/sdk", "packages/contracts"]
    },
    {
      "path": "apps/deploy",
      "allowed": [
        "packages/contracts",
        "packages/extension-api",
        "packages/signing",
        "packages/resolution"
      ]
    }
  ]
}
