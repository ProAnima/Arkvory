{
  "profiles": {
    "quick": ["static", "unit"],
    "verify": [
      "static",
      "unit",
      "security",
      "integration",
      "browser",
      "docs",
      "deployment",
      "deployment-services",
      "deployment-containers",
      "native-install",
      "deployment-stand",
      "deployment-nas"
    ],
    "release": [
      "static",
      "unit",
      "security",
      "integration",
      "browser",
      "docs",
      "large-full",
      "large-multipart",
      "deployment",
      "deployment-services",
      "deployment-containers",
      "native-install",
      "deployment-stand",
      "deployment-nas"
    ],
    "large": ["large-full", "large-multipart"]
  },
  "tasks": {
    "static": {
      "needs": ["policy"],
      "timeoutSeconds": 600,
      "commands": [
        {
          "script": "node_modules/prettier/bin/prettier.cjs",
          "args": [".", "--check"]
        },
        {
          "script": "scripts/check-types.mjs",
          "args": []
        },
        {
          "script": "node_modules/eslint/bin/eslint.js",
          "args": ["apps", "packages", "--max-warnings=0"]
        },
        {
          "script": "node_modules/dependency-cruiser/bin/dependency-cruiser.mjs",
          "args": ["--config", ".dependency-cruiser.cjs", "apps", "packages"]
        }
      ]
    },
    "build": {
      "needs": ["policy"],
      "timeoutSeconds": 600,
      "commands": [
        {
          "script": "scripts/build.mjs",
          "args": []
        }
      ]
    },
    "unit": {
      "needs": ["build"],
      "timeoutSeconds": 300,
      "pattern": "tests/*.test.mjs",
      "concurrency": 2,
      "kind": "node-test"
    },
    "integration": {
      "needs": ["build"],
      "timeoutSeconds": 900,
      "pattern": "tests/integration/**/*.test.mjs",
      "kind": "node-test",
      "database": true
    },
    "browser": {
      "needs": ["build"],
      "timeoutSeconds": 600,
      "entries": [
        "tests/browser/console.mjs",
        "tests/browser/management.mjs",
        "tests/browser/downloads.mjs",
        "tests/browser/updates.mjs",
        "tests/browser/feedback.mjs",
        "tests/browser/download-link.mjs",
        "tests/browser/remote-wizard.mjs"
      ],
      "kind": "scenario",
      "database": true,
      "browser": true
    },
    "docs": {
      "needs": ["build"],
      "timeoutSeconds": 600,
      "commands": [
        {
          "script": "scripts/wiki.mjs",
          "args": ["build"]
        }
      ]
    },
    "large-full": {
      "needs": ["build"],
      "timeoutSeconds": 900,
      "entries": ["tests/large-transfer.mjs"],
      "kind": "scenario",
      "database": true
    },
    "large-multipart": {
      "needs": ["build"],
      "timeoutSeconds": 1200,
      "entries": ["tests/large-transfer.mjs"],
      "args": ["--multipart", "--verified", "--traffic", "--managed"],
      "kind": "scenario",
      "database": true
    },
    "security": {
      "needs": [],
      "timeoutSeconds": 120,
      "commands": [
        {
          "script": "$npm",
          "args": ["audit", "--audit-level=high"]
        }
      ]
    },
    "policy": {
      "needs": [],
      "timeoutSeconds": 120,
      "commands": [
        {
          "script": "scripts/check-policy.mjs",
          "args": []
        }
      ]
    },
    "deployment": {
      "needs": ["build"],
      "timeoutSeconds": 600,
      "entries": ["tests/deployment/package.mjs"],
      "kind": "scenario"
    },
    "deployment-services": {
      "needs": ["build"],
      "timeoutSeconds": 300,
      "entries": ["tests/deployment/services.mjs"],
      "kind": "scenario"
    },
    "deployment-containers": {
      "needs": ["build"],
      "timeoutSeconds": 1200,
      "entries": ["tests/deployment/containers.mjs"],
      "kind": "scenario"
    },
    "native-package": {
      "needs": ["build"],
      "timeoutSeconds": 1800,
      "entries": ["tests/deployment/native-package.mjs"],
      "kind": "scenario"
    },
    "native-install": {
      "needs": ["native-package"],
      "timeoutSeconds": 1500,
      "entries": ["tests/deployment/native-install.mjs"],
      "kind": "scenario"
    },
    "deployment-stand": {
      "needs": ["native-package"],
      "timeoutSeconds": 1800,
      "entries": ["tests/deployment/two-site-stand.mjs", "tests/deployment/upgrade-stand.mjs"],
      "kind": "scenario"
    },
    "deployment-nas": {
      "needs": ["native-package"],
      "timeoutSeconds": 1500,
      "entries": ["tests/deployment/nas-stand.mjs"],
      "kind": "scenario"
    }
  },
  "spawnedHelpers": [
    "tests/integration/api-child.mjs",
    "tests/deployment/service-child.mjs",
    "tests/deployment/process-child.mjs",
    "tests/deployment/stand-probe.mjs",
    "tests/watchdog-child.mjs"
  ],
  "mergeTasks": [
    "static",
    "unit",
    "security",
    "integration",
    "browser",
    "docs",
    "deployment",
    "deployment-services",
    "deployment-containers",
    "native-package",
    "native-install",
    "deployment-stand",
    "deployment-nas"
  ],
  "releaseTasks": ["large-full", "large-multipart"]
}
