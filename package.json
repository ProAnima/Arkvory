{
  "name": "@proanima/depot",
  "version": "0.0.0",
  "private": true,
  "description": "Автономное хранилище UPack и файлов: метаданные, метки, очереди и API ProGet. / Self-hosted UPack and file storage with metadata, tagging, transfer queues, and ProGet-compatible APIs.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "release:package": "node scripts/package-release.mjs",
    "check": "node scripts/gates.mjs static",
    "typecheck": "node scripts/check-types.mjs",
    "lint": "eslint apps packages --max-warnings=0",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "migrate": "node --env-file-if-exists=.env apps/api/dist/migrate.js",
    "test": "node scripts/gates.mjs unit",
    "test:integration": "node --env-file-if-exists=.env.test scripts/gates.mjs integration",
    "test:large": "node --env-file-if-exists=.env.test scripts/gates.mjs large",
    "init:local": "node scripts/init-local.mjs",
    "upload": "node --env-file-if-exists=.env scripts/upload.mjs",
    "worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "gc": "node --env-file-if-exists=.env apps/worker/dist/gc.js",
    "import": "node --env-file-if-exists=.env scripts/import.mjs",
    "scrub": "node --env-file-if-exists=.env apps/worker/dist/scrub.js",
    "upack:manifest": "node scripts/upack-manifest.mjs",
    "gate": "node --env-file-if-exists=.env.test scripts/gates.mjs",
    "gate:list": "node scripts/gates.mjs --list",
    "test:browser": "node --env-file-if-exists=.env.test scripts/gates.mjs browser",
    "test:browser:install": "node node_modules/playwright/cli.js install --with-deps chromium",
    "policy:check": "node scripts/check-policy.mjs",
    "test:db:up": "docker compose -f compose.test.yml up -d --wait",
    "test:db:stop": "docker compose -f compose.test.yml stop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1",
    "yazl": "3.3.1"
  },
  "homepage": "https://github.com/ProAnima/Depot",
  "license": "UNLICENSED",
  "author": "Ian Panaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProAnima/Depot.git"
  }
}
